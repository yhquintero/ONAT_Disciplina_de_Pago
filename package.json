{
  "name": "onat-disciplina-de-pago",
  "version": "1.0.0",
  "description": "Panel web local de análisis de disciplina de pago y cobros",
  "scripts": {
    "test": "node --test",
    "dev": "cross-env LOCAL_HTTPS=true vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm test && npm run build && npm run check:dist",
    "check:dist": "node scripts/check-public-artifact.mjs",
    "dev:https": "cross-env LOCAL_HTTPS=true vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:preview": "cross-env LOCAL_HTTPS=false vite --host 0.0.0.0",
    "dev:http": "cross-env LOCAL_HTTPS=false vite --host 0.0.0.0 --port 5173 --strictPort",
    "build:desktop": "cross-env VITE_PORTABLE_BUILD=true vite build",
    "package:portable:windows": "npm run build:desktop && cross-env ELECTRON_INSTALL_PLATFORM=win32 ELECTRON_INSTALL_ARCH=x64 node node_modules/electron/install.js && electron-builder --win portable --x64"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhquintero/ONAT_Disciplina_de_Pago.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/yhquintero/ONAT_Disciplina_de_Pago/issues"
  },
  "homepage": "https://github.com/yhquintero/ONAT_Disciplina_de_Pago#readme",
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "chart.js": "^4.6.1",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "vite": "^8.3.5"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "minimatch": "^11.0.3",
    "uuid": "^11.1.1"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "cu.onat.disciplina-de-pago",
    "productName": "ONAT Disciplina de Pago",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.cjs",
      "assets/onat.ico",
      "dist/**/*",
      "package.json",
      "!node_modules/**",
      "!**/*.xls",
      "!**/*.xlsx",
      "!**/*.xlsm",
      "!**/*.xlsb"
    ],
    "npmRebuild": false,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ONAT-Disciplina-de-Pago-${version}-portable-${arch}.${ext}",
      "icon": "assets/onat.ico",
      "signExecutable": false
    }
  }
}
